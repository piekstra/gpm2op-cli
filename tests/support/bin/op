#!/bin/sh
# Stand-in for the 1Password CLI in the integration tests. The tests put this
# directory first on PATH (and leave the real op's directories off it), so no
# test can reach a real vault or raise a 1Password prompt.
#
#   FAKE_OP_DIR        directory of op's JSON answers (tests/fixtures/op)
#   FAKE_OP_ITEM_LIST  which `op item list` answer to give (default item-list.json)
#   FAKE_OP_LOG        file each call's argv is appended to, one line per call
#   FAKE_OP_EDIT_FAIL  when set, `op item edit` fails after recording its template
#   FAKE_OP_EDIT_SIGNAL  when set (INT, TERM, ...), `op item edit` sends that
#                      signal to gpm2op and fails, as a Ctrl-C mid-edit would
#
# `op item create` fails for a template that names fail.example, so an export
# row on that host stands for a row 1Password refuses.
set -eu

: "${FAKE_OP_DIR:?FAKE_OP_DIR is not set}"
log="${FAKE_OP_LOG:-/dev/null}"
printf 'argv %s\n' "$*" >>"$log"

if [ "${1:-}" = "--account" ]; then
	shift 2
fi

case "${1:-} ${2:-}" in
"vault list")
	cat "$FAKE_OP_DIR/vault-list.json"
	;;
"item list")
	cat "$FAKE_OP_DIR/${FAKE_OP_ITEM_LIST:-item-list.json}"
	;;
"item create")
	template=$(cat)
	case "$template" in
	*fail.example*)
		echo "[ERROR] 2026/01/01 00:00:00 the test refuses this item" >&2
		exit 1
		;;
	esac
	cat "$FAKE_OP_DIR/item-create.json"
	;;
"item get")
	cat "$FAKE_OP_DIR/item-get-revealed.json"
	;;
"item edit")
	# op item edit <id> --template <path>
	path=$5
	mode=$(stat -c %a "$path" 2>/dev/null || stat -f %Lp "$path")
	printf 'template %s %s\n' "$mode" "$path" >>"$log"
	if [ -n "${FAKE_OP_EDIT_SIGNAL:-}" ]; then
		kill -s "$FAKE_OP_EDIT_SIGNAL" "$PPID"
		exit 130
	fi
	if [ -n "${FAKE_OP_EDIT_FAIL:-}" ]; then
		echo "[ERROR] 2026/01/01 00:00:00 the test refuses this edit" >&2
		exit 1
	fi
	cat "$FAKE_OP_DIR/item-get-revealed.json"
	;;
*)
	echo "fake op: unexpected arguments: $*" >&2
	exit 2
	;;
esac
